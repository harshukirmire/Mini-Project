rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper functions
    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    function isAdmin() {
      return isAuthenticated() && (
        request.auth.token.admin == true ||
        request.auth.token.email == "minalakre40@gmail.com" ||
        exists(/databases/$(database)/documents/admins/$(request.auth.uid))
      );
    }

    // Public / Verified Scholarships: Everyone authenticated or unauthenticated can read; only admins can write
    match /scholarships/{scholarshipId} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }

    // Public Exam Directory: Everyone can read; only admins can write
    match /exams/{examId} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }

    // Admin list
    match /admins/{userId} {
      allow read: if isAuthenticated();
      allow write: if isAdmin();
    }

    // User Profile Documents
    match /users/{userId} {
      allow read: if isAuthenticated();
      allow create, update: if isOwner(userId);
      allow delete: if isOwner(userId) || isAdmin();

      // Exam Results Subcollection
      match /examResults/{examResultId} {
        allow read, write: if isOwner(userId);
      }

      // Saved Scholarships Subcollection
      match /savedScholarships/{scholarshipId} {
        allow read, write: if isOwner(userId);
      }

      // Application Tracker Subcollection
      match /applications/{applicationId} {
        allow read, write: if isOwner(userId);
      }

      // Reminders Subcollection
      match /reminders/{reminderId} {
        allow read, write: if isOwner(userId);
      }
    }
  }
}
